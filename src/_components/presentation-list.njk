<section id="locations" class="section locations" aria-labelledby="locations-title">
  <div class="container">
    <header class="section__head">
      <h2 id="locations-title">Where Presentations will be held</h2>
    </header>

    <div class="locations__map-wrap">
      <div
        id="locations-map"
        class="locations__map"
        data-locale="en"
        role="region"
        aria-label="Map of presentation locations across California"
      ></div>
      <script type="application/json" id="locations-map-data">{{ cities | locationsMapData | safe }}</script>
      <p class="locations__map-hint">Tap a pin for venue details and registration.</p>
    </div>

    <ul class="locations__list" role="list">
      {% for place in cities %}
        {% set endsAt = place | latestSessionEnd %}
        <li
          class="location-card"
          {% if endsAt %}data-ends-at="{{ endsAt }}" data-timezone="{{ place | sessionTimezone }}"{% endif %}
        >
          <h3 class="location-card__title">
            {{ place.city }}{% if place.region %}, {{ place.region }}{% endif %}
          </h3>
          {% if place.sessions and place.sessions[0].date %}
            <p class="location-card__date">{{ place.sessions[0].date }}</p>
          {% endif %}
          {% if place.locationNote %}
            <p class="location-card__note">{{ place.locationNote }}</p>
          {% endif %}
          {% if place.venueName %}
            <p class="location-card__venue">{{ place.venueName }}</p>
          {% endif %}
          <address class="location-card__address">
            {% for line in place.addressLines %}
              {{ line }}{% if not loop.last %}<br />{% endif %}
            {% endfor %}
          </address>
          <p class="location-card__actions">
            <span data-register-action>
              <a href="/local-presentations/{{ place.slug }}/"><button class="btn btn--primary" type="button">Register</button></a>
            </span>
            <a class="location-card__link location-card__link--primary" href="/local-presentations/{{ place.slug }}/">
              Location details
            </a>
            {% set mapLinkUrl = place | mapsLinkUrl %}
            {% if mapLinkUrl %}
              <a class="location-card__link" href="{{ mapLinkUrl }}" rel="noopener noreferrer" target="_blank">Open in Maps</a>
            {% endif %}
          </p>
        </li>
      {% endfor %}

      <li class="location-card location-card--zoom" data-final-zoom hidden>
        <p class="location-card__kicker">Final opportunity</p>
        <h3 class="location-card__title">Zoom class</h3>
        <p class="location-card__date">Online — registration required</p>
        <p class="location-card__venue">
          All in-person presentations have concluded. Register for a final Zoom class to hear this presentation online.
        </p>
        <p class="location-card__actions">
        </p>
      </li>
    </ul>
  </div>
</section>
