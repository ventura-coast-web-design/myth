---
layout: base.njk
mainClass: site-main--bright
---

<div class="page-header page-header--bright transcript-page__banner">
  {{ title }}
</div>

<div class="container transcript-page">
  {% if videoTitle or youtubeVideoId %}
    <div class="transcript-page__toolbar">
      {% set watchHref = youtubeVideoId | videoWatchHref(videos) %}
      {% if watchHref and videoTitle %}
        <a class="btn btn--bright-primary transcript-page__watch" href="{{ watchHref }}">Watch &ldquo;{{ videoTitle }}&rdquo;</a>
      {% elif watchHref %}
        <a class="btn btn--bright-primary transcript-page__watch" href="{{ watchHref }}">Watch the video</a>
      {% elif videoTitle %}
        <span class="transcript-page__video-label">{{ videoTitle }}</span>
      {% endif %}
    </div>
  {% endif %}

  <article class="transcript-prose">
    {{ content | safe }}
  </article>

  <nav class="transcript-page__footer-nav" aria-label="Transcript navigation">
    {% if backUrl %}
      <a class="btn btn--bright-outline" href="{{ backUrl }}">{{ backLabel or "Back" }}</a>
    {% else %}
      <a class="btn btn--bright-outline" href="/transcripts/">All transcripts</a>
      <a class="btn btn--bright-outline" href="/about/">About</a>
    {% endif %}
  </nav>
</div>
